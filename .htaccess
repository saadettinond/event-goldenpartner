Options -Indexes
DirectoryIndex index.html

# Ayar dosyasına ve gizli dosyalara tarayıcıdan erişim kapalı
<FilesMatch "^(ayarlar(\.ornek)?\.php|\..*|.*\.md)$">
  Require all denied
</FilesMatch>

# Görsel ve videolar tarayıcıda önbelleğe alınsın
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/png  "access plus 30 days"
  ExpiresByType video/mp4  "access plus 30 days"
</IfModule>
AddType video/mp4 .mp4

# Sayfa her açılışta güncel sürümü kontrol etsin (değişiklikler hemen görünsün)
<FilesMatch "\.html$">
  <IfModule mod_headers.c>
    Header set Cache-Control "no-cache, must-revalidate"
  </IfModule>
</FilesMatch>

# Takvim dosyası (iPhone/Mac "Takvime ekle")
AddType text/calendar .ics
AddCharset UTF-8 .ics
